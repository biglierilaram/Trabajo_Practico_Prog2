enum DiaSemana{
LUNES,
MARTES, 
MIERCOLES, 
JUEVES, 
VIERNES, 
SABADO, 
DOMINGO, 
}

------------------------------------------------------------------------------------

enum TipoDeMetodoDePago{
EFECTIVO,
TARJETA,
BILLETERAVIRTUAL,
}

------------------------------------------------------------------------------------

abstract class MetodoDePago{

#NombreMetodoDePago: String
#TipoDeMetodoDePago: TipoDeMetodoDePago

+CalcularDescuento(dto: Descuentos)

}

------------------------------------------------------------------------------------

class Efectivo{

}

------------------------------------------------------------------------------------

class Tarjetas{

}

------------------------------------------------------------------------------------

class BilleteraVirtual{

}

------------------------------------------------------------------------------------

abstract class Descuentos{
+EsAplicable(Caja:Caja):boolean  
}

------------------------------------------------------------------------------------

class DiaDescuentos extends Descuentos{
-Dia: DiaSemana
-PorcentajeDia: number 

+EsAplicable(Caja:Caja):boolean{
 return if(this.Caja.Pedido.GetFechaPedido()=== this.Dia);
}
}

------------------------------------------------------------------------------------

class EfectivoDescuentos extends Descuentos{

-PorcentajeEfectivo: number    
+EsAplicable(Caja:Caja):boolean{
return if(this.Caja.GetMetodoDePago === This.MetodoDePago.EFECTIVO)
}
}


'//////////////////////////////////////////////////////////////////////////////////////////////////
' Relaciones

Cliente *-- Pedido
DiaSemana--Pedido

Descuentos <|-- DiaDescuentos
Descuentos <|-- EfectivoDescuentos


Pedido <|-- PedidoSalon
Pedido <|-- PedidoRetirar
Pedido <|--PedidoEnvio
Pedido *-l-Estacion 
Pedido <|-- Item
Pedido o--Categoria


Item <|-- Articulo
Item <|-- Combo
Item o-l- MetodoDePago


MetodoDePago <|-- Efectivo
MetodoDePago <|-- Tarjetas
MetodoDePago <|-- BilleteraVirtual
MetodoDePago o-l- Descuentos

Combo *--PrecioCombo

PrecioCombo <|-- DescuentoPorcentualCombo
PrecioCombo <|-- DescuentoFijoCombo

