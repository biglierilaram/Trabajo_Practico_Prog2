enum DiaSemana{
LUNES,
MARTES, 
MIERCOLES, 
JUEVES, 
VIERNES, 
SABADO, 
DOMINGO, 
}



enum TipoDeMetodoDePago{
EFECTIVO,
TARJETA,
BILLETERAVIRTUAL,
}



abstract class MetodoDePago{

#NombreMetodoDePago: String
#TipoDeMetodoDePago: TipoDeMetodoDePago

+GetMetodoDePago():string
+GetTipoDeMetodoDePago(): TipoDeMetodoDePago
}



class Efectivo{

}



class Tarjetas{

}



class BilleteraVirtual{

}



abstract class Descuento{

#PorcentajeDescuento:number

+EsAplicable():boolean 
+CantidadDeDescuento():number 
+GetPorcentajeDescuento():number
+AplicarDescuento():number

}


class DescuentoPorDia{

-Dia: DiaSemana

+EsAplicable():boolean

}

class DescuentoPorMetodoDePago{

-MetodoDePago:TipoDeMetodoDePago

+EsAplicable():boolean

}

class Caja{

-Pedidos: Pedido
-MetodoDePago: MetodoDePago

+CompetenciaDeDescuentos()
+CobrarPrecioFinalConDescuento()
+GetMetodoDePago()
+getDiaPedido()

}

