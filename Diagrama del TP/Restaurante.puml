@startuml Restaurante

title Gestión de pedidos - Restaurante

skinparam classAttributeIconSize 0
hide empty members

' ==================================================
' PEDIDOS
' ==================================================

abstract class Pedido {
    #idPedido: number
    #diaDePedido: DiaSemana
    #productosFinales: Item[]
    #estado: EstadoPedido

    +constructor(idPedido: number, diaDePedido: DiaSemana)
    +agregarItems(item: Item): void
    +quitarItem(item: Item): void
    +confirmar(): void
    +estaConfirmado(): boolean
    +calcularPrecioTotalPedidoSinDescuentos(): number
    +estanTodosLosItemsListos(): boolean
    +getDiaDePedido(): DiaSemana
    +getIdPedido(): number
    +getItems(): Item[]
}

class PedidoSalon {
    -numeroDeMesa: number
    +getNumeroDeMesa(): number
    +quitarItemsHasta(item: Item): void
}

class PedidoRetirar {
    -horarioDeRetiro: string
    +getHorarioDeRetiro(): string
    +quitarItemsHasta(item: Item): void
}

class PedidoEnvio {
    -domicilioPedido: string
    -costoDeEnvio: number
    +getDomicilioPedido(): string
    +getCostoDeEnvio(): number
}

Pedido <|-- PedidoSalon
Pedido <|-- PedidoRetirar
Pedido <|-- PedidoEnvio

Pedido "1" o-- "0..*" Item : productosFinales

' ==================================================
' ITEMS Y COMBOS
' ==================================================

abstract class Item {
    #nombre: string
    #idItem: number
    #estado: EstadoItem

    +constructor(nombre: string, idItem: number)
    +precioFinal(): number
    +iniciarPreparacion(): void
    +finalizarPreparacion(): void
    +getEstado(): EstadoItem
}

class Articulo {
    -precioArticulo: number
    -categoria: Categoria
    -estacion: TipoDeEstacion
    +precioFinal(): number
    +getEstacion(): TipoDeEstacion
}

class Combo {
    -articulos: Articulo[]
    -estrategiaPrecio: PrecioCombo
    +precioFinal(): number
    +getArticulos(): Articulo[]
    +getEstado(): EstadoItem
    +iniciarPreparacion(): void
    +finalizarPreparacion(): void
}

Item <|-- Articulo
Item <|-- Combo

Combo "1" o-- "1..*" Articulo : articulos

' ==================================================
' STRATEGY: PRECIO DE COMBOS
' ==================================================

abstract class PrecioCombo {
    +calcularPrecio(precioOriginal: number): number
}

class DescuentoFijoCombo {
    -montoDescontado: number
    +calcularPrecio(precioOriginal: number): number
}

class DescuentoPorcentualCombo {
    -porcentajeDescuento: number
    +calcularPrecio(precioOriginal: number): number
}

PrecioCombo <|-- DescuentoFijoCombo
PrecioCombo <|-- DescuentoPorcentualCombo

Combo --> PrecioCombo : estrategiaPrecio

' ==================================================
' ESTACIONES Y RESTAURANTE
' ==================================================

class Estacion {
    -tipoDeEstacion: TipoDeEstacion
    -colaDeItems: Item[]
    -itemEnPreparacion: Item | null

    +constructor(tipoDeEstacion: TipoDeEstacion)
    +recibirItem(item: Item): void
    +iniciarSiguienteItem(): Item
    +finalizarItemActual(): Item
    +getTipoDeEstacion(): TipoDeEstacion
    +getCantidadItemsEnEspera(): number
    +getItemEnPreparacion(): Item | null
}

class Restaurante {
    -estaciones: Estacion[]

    +constructor(estaciones: Estacion[])
    +confirmarYDistribuirPedido(pedido: Pedido): void
    -buscarEstacion(tipo: TipoDeEstacion): Estacion
    +getEstacion(tipo: TipoDeEstacion): Estacion
}

Restaurante "1" o-- "1..*" Estacion
Estacion --> Item : prepara
Restaurante ..> Pedido : confirma y distribuye

' ==================================================
' MEDIOS DE PAGO
' ==================================================

abstract class MetodoDePago {
    #nombreMetodoDePago: string
    #tipoDeMetodoDePago: TipoDeMetodoDePago

    +getNombreMetodoDePago(): string
    +getTipoDeMetodoDePago(): TipoDeMetodoDePago
}

class Efectivo
class Tarjetas
class BilleteraVirtual

MetodoDePago <|-- Efectivo
MetodoDePago <|-- Tarjetas
MetodoDePago <|-- BilleteraVirtual

' ==================================================
' STRATEGY: DESCUENTOS
' ==================================================

abstract class Descuento {
    #porcentajeDescuento: number

    +esAplicable(condicion: Caja): boolean
    +cantidadDeDescuento(cantidad: number): number
    +getPorcentajeDescuento(): number
    +aplicarDescuento(cantidad: number): number
}

class DescuentoPorDia {
    -diaDeLaSemana: DiaSemana
    +esAplicable(condicion: Caja): boolean
}

class DescuentoPorMetodoDePago {
    -tipoDeMetodoDePago: TipoDeMetodoDePago
    +esAplicable(condicion: Caja): boolean
}

Descuento <|-- DescuentoPorDia
Descuento <|-- DescuentoPorMetodoDePago

' ==================================================
' CAJA
' ==================================================

class Caja {
    -pedidos: Pedido
    -metodoDePago: MetodoDePago
    -importeCobrado: number | null

    +constructor(pedidos: Pedido, metodoDePago: MetodoDePago)
    +competenciaDeDescuentos(descuentos: Descuento[], precio: number): number
    +cobrarPrecioFinalConDescuento(descuentos: Descuento[]): number
    +getPedido(): Pedido
    +getMetodoDePago(): MetodoDePago
    +getImporteCobrado(): number | null
    +getDiaPedido(): DiaSemana
}

Caja --> Pedido
Caja --> MetodoDePago
Caja ..> Descuento : aplica

' ==================================================
' HISTORIAL DE PEDIDOS
' ==================================================

interface RegistroPedido {
    +pedido: Pedido
    +importeCobrado: number
}

class HistorialPedidos {
    -registros: RegistroPedido[]

    +constructor()
    +registrarPedido(caja: Caja): void
    +consultarHistorial(): RegistroPedido[]
    +buscarPedido(idPedido: number): RegistroPedido | undefined
    +getCantidadPedidos(): number
}

HistorialPedidos "1" *-- "0..*" RegistroPedido
RegistroPedido --> Pedido
HistorialPedidos ..> Caja : registra pedido cobrado

' ==================================================
' ENUMERACIONES
' ==================================================

enum Categoria {
    ENTRADA
    PLATOPRINCIPAL
    BEBIDA
    POSTRE
}

enum TipoDeEstacion {
    CARNES
    ENSALADAS
    POSTRES
    BARRA
}

enum DiaSemana {
    LUNES
    MARTES
    MIERCOLES
    JUEVES
    VIERNES
    SABADO
    DOMINGO
}

enum TipoDeMetodoDePago {
    EFECTIVO
    TARJETA
    BILLETERAVIRTUAL
}

enum EstadoItem {
    PENDIENTE
    EN_PREPARACION
    LISTO
}

enum EstadoPedido {
    EN_CONSTRUCCION
    CONFIRMADO
}

Articulo --> Categoria
Articulo --> TipoDeEstacion
Item --> EstadoItem
Pedido --> EstadoPedido
Pedido --> DiaSemana
MetodoDePago --> TipoDeMetodoDePago
DescuentoPorDia --> DiaSemana

@enduml
